#:kivy 1.0.9

<FlatButton@Button>:
    background_normal: ''
    background_color: (0.94, 0.94, 0.94, 1)
    color: (0.1, 0.1, 0.1, 1)
    bold: False
    font_size: self.height * 0.38
    border_radius: [4, 4, 4, 4]
    canvas.before:
        Color:
            rgba: self.background_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [4]

<OpButton@FlatButton>:
    background_color: (0.88, 0.88, 0.88, 1)
    color: (0.1, 0.1, 0.1, 1)

<EqualButton@FlatButton>:
    background_color: (0.0, 0.28, 0.54, 1)
    color: (1, 1, 1, 1)

<FuncButton@FlatButton>:
    background_color: (0.91, 0.91, 0.91, 1)
    color: (0.1, 0.1, 0.1, 1)

<MemButton@Button>:
    background_normal: ''
    background_color: (1, 1, 1, 0)
    color: (0.35, 0.35, 0.35, 1)
    font_size: self.height * 0.38
    bold: False

<CalculatorLayout>:
    orientation: 'vertical'
    spacing: 0
    padding: 0

    canvas.before:
        Color:
            rgba: (1, 1, 1, 1)
        Rectangle:
            pos: self.pos
            size: self.size

    # Cabeçalho
    BoxLayout:
        size_hint_y: None
        height: 48
        padding: [14, 0, 8, 0]
        canvas.before:
            Color:
                rgba: (1, 1, 1, 1)
            Rectangle:
                pos: self.pos
                size: self.size
        Widget:
    # Display
    BoxLayout:
        size_hint_y: 0.22
        padding: [14, 0, 14, 0]
        canvas.before:
            Color:
                rgba: (1, 1, 1, 1)
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            id: display
            text: '0'
            font_size: self.height * 0.65
            halign: 'right'
            valign: 'bottom'
            text_size: self.size
            color: (0.07, 0.07, 0.07, 1)
            padding: [0, 8, 0, 8]

    # Linha de memória
    BoxLayout:
        size_hint_y: None
        height: 44
        spacing: 0
        padding: [4, 0, 4, 0]
        canvas.before:
            Color:
                rgba: (1, 1, 1, 1)
            Rectangle:
                pos: self.pos
                size: self.size

      
    # Separador
    BoxLayout:
        size_hint_y: None
        height: 1
        canvas.before:
            Color:
                rgba: (0.85, 0.85, 0.85, 1)
            Rectangle:
                pos: self.pos
                size: self.size

    # Teclado
    GridLayout:
        cols: 4
        rows: 6
        spacing: 1
        size_hint_y: 1
        padding: [1, 1, 1, 1]
        canvas.before:
            Color:
                rgba: (0.82, 0.82, 0.82, 1)
            Rectangle:
                pos: self.pos
                size: self.size

        # Linha 1
        FuncButton:
            text: '%'
            on_press: root.on_button_press(self)
        FuncButton:
            text: 'CE'
            on_press: root.on_button_press(self)
        FuncButton:
            text: 'C'
            on_press: root.on_button_press(self)
        FuncButton:
            text: '←'
            on_press: root.on_button_press(self)

        # Linha 2
        FuncButton:
            text: '¹/x'
            on_press: root.on_button_press(self)
        FuncButton:
            text: '^2'
            on_press: root.on_button_press(self)
        FuncButton:
            text: '√'
            on_press: root.on_button_press(self)
        OpButton:
            text: '÷'
            on_press: root.on_button_press(self)

        # Linha 3
        FlatButton:
            text: '7'
            on_press: root.on_button_press(self)
        FlatButton:
            text: '8'
            on_press: root.on_button_press(self)
        FlatButton:
            text: '9'
            on_press: root.on_button_press(self)
        OpButton:
            text: '×'
            on_press: root.on_button_press(self)

        # Linha 4
        FlatButton:
            text: '4'
            on_press: root.on_button_press(self)
        FlatButton:
            text: '5'
            on_press: root.on_button_press(self)
        FlatButton:
            text: '6'
            on_press: root.on_button_press(self)
        OpButton:
            text: '-'
            on_press: root.on_button_press(self)

        # Linha 5
        FlatButton:
            text: '1'
            on_press: root.on_button_press(self)
        FlatButton:
            text: '2'
            on_press: root.on_button_press(self)
        FlatButton:
            text: '3'
            on_press: root.on_button_press(self)
        OpButton:
            text: '+'
            on_press: root.on_button_press(self)

        # Linha 6
        FuncButton:
            text: '+/-'
            on_press: root.on_button_press(self)
        FlatButton:
            text: '0'
            on_press: root.on_button_press(self)
        FlatButton:
            text: '.'
            on_press: root.on_button_press(self)
        EqualButton:
            text: '='
            on_press: root.on_button_press(self)